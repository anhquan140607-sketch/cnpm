# Application Configuration
FLASK_APP=src/app.py
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=film_contest_secret_key_jwt_2026

# Database Type: POSTGREE | MYSQL | MSSQL
DB_TYPE=POSTGREE

# PostgreSQL Configuration (Khớp với database hiện có của dự án)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=film_contest_db
POSTGREE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/film_contest_db

# MySQL Configuration (Dễ dàng chuyển đổi theo yêu cầu của Giảng viên)
MYSQL_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/film_contest_db

# MS SQL Server Configuration (Dễ dàng chuyển đổi theo yêu cầu của Giảng viên)
MSSQL_DATABASE_URL=mssql+pymssql://sa:password@127.0.0.1:1433/film_contest_db
